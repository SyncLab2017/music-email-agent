    {
      "parameters": {
        "jsCode": "const content = $input.item.json.choices[0].message.content;\nconst cleanJson = content.replace(/```json/g, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(cleanJson);\n\n// Логика обработки даты\nif (parsed.date) {\n  // DeepSeek возвращает ДД.ММ.ГГГГ (22.02.2026). Превращаем в YYYY-MM-DD\n  const parts = parsed.date.split('.');\n  if (parts.length === 3) {\n    parsed.date = `${parts[2]}-${parts[1]}-${parts[0]}`;\n  }\n} else {\n  // Если DeepSeek не нашел дату — ставим сегодняшнюю\n  parsed.date = new Date().toISOString().split('T')[0];\n}\n\nreturn { json: parsed };"
      },
