# --- IMAP (inbound mail source) ---
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USER=music@synclab.pro
IMAP_PASSWORD=
IMAP_MAILBOX=Music e-mail
IMAP_TO_FILTER=music@synclab.pro
POLL_INTERVAL_MS=120000

# --- Outbound (Resend HTTP API) ---
# Yandex SMTP blocks Railway IPs, so we send via Resend.
# Verify synclab.pro in Resend → Domains and copy the API key here.
RESEND_API_KEY=
# BCC yourself to keep a copy in your Yandex inbox (leave blank to disable).
RESEND_BCC=denis@synclab.pro

# From identity shown to recipients (must be an address on the verified domain).
SMTP_FROM_NAME=Denis Sharko | Synclab
SMTP_FROM_EMAIL=denis@synclab.pro

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Google Sheets (Service Account) ---
# Paste the entire service-account JSON on a single line (or base64 — see loader)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=1SsJvaPwWFasHbgGWYU6R6DA-TZx6ALDC_xbfpbcENfA
GOOGLE_SHEET_TAB=Лист1

# --- SQLite state store ---
# Local dev: point at ./data/state.db. Railway prod: mount a volume at /data
# and leave this empty (Dockerfile default is /data/state.db).
SQLITE_PATH=

# --- Telegram bot ---
TG_BOT_TOKEN=
# Chat / channel where cards land (approve/reject buttons work in channels
# too if the bot is a channel admin). One id or two — see TG_SUMMARY_CHAT_ID.
TG_APPROVER_CHAT_ID=
# Optional: separate channel for read-only feed of every parsed email.
# If empty, summaries land in TG_APPROVER_CHAT_ID together with buttons.
TG_SUMMARY_CHAT_ID=
TG_WEBHOOK_SECRET=change-me-random-hex

# --- Railway ---
# Set by Railway; falls back to localhost for local dev
PORT=8080
PUBLIC_URL=

# Cooldown for auto-replies to same sender (days)
REPLY_COOLDOWN_DAYS=30
